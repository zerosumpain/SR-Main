[Unit]
Description=JKAI builder sidecar — owns the build orchestrator loop, decoupled from the SvelteKit web app so deploys don't kill in-flight builds. See docs/plans/jkai-build-rewrite.md.
After=network.target

[Service]
Type=simple
User=johnk
Group=johnk
WorkingDirectory=/opt/strange-rambling-svelte
EnvironmentFile=/opt/strange-rambling-svelte/.env
Environment=NODE_ENV=production
Environment=JKAI_BUILDER_SOCKET=/run/jkai-builder/jkai-builder.sock
Environment=JKAI_BUILDS_ROOT=/opt/jkai-builds
RuntimeDirectory=jkai-builder
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/node /opt/strange-rambling-svelte/packages/jkai-builder/dist/start.js
Restart=always
RestartSec=5

# Resource caps — a runaway agent shouldn't eat the whole VPS.
MemoryMax=4G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
