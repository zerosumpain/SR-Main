[Unit]
Description=JKAI builder sidecar — owns the build orchestrator loop, decoupled from the SvelteKit web app so deploys don't kill in-flight builds. See docs/plans/jkai-build-rewrite.md.
After=network.target

[Service]
Type=simple
User=johnk
Group=johnk
WorkingDirectory=/opt/strange-rambling-svelte
EnvironmentFile=/opt/strange-rambling-svelte/.env
Environment=NODE_ENV=production
Environment=JKAI_BUILDER_SOCKET=/run/jkai-builder/jkai-builder.sock
Environment=JKAI_BUILDS_ROOT=/opt/jkai-builds
Environment=JKAI_BUILDS_HOSTMODE=1
Environment=JKAI_BUILDER_PROCESS=1
RuntimeDirectory=jkai-builder
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/node /opt/strange-rambling-svelte/packages/jkai-builder/dist/start.js
Restart=always
RestartSec=5

# Resource caps — a runaway agent shouldn't eat the whole VPS.
#
# These were 4G/200% on an 8-core, 15.6 GB box, and the gate runs inside them:
# `execInSandbox` in host mode is a `bash -c` child of this unit, so it inherits
# the cgroup. Measured on 2026-08-12 with change request #223 in flight, the
# cost was not subtle — cpu.stat showed 7,898 throttled periods out of 34,481
# (22.9%), and memory.peak was 4,294,971,392 against a memory.max of
# 4,294,967,296: pinned to the ceiling, with 37,144 recorded hits against it.
#
# vitest sizes its pool from the machine (8 cores → 7 workers) and cannot see
# the quota, so it forked seven workers to share two cores' worth. `gate:build`
# asks for a 6 GB heap (package.json) inside a 4 GB cap, so it swapped. One
# gate run took 7m54s here against 1m59s for the same workload on the same box
# outside the cgroup.
#
# 7G was not enough, and the reason took three wrong turns to find. What lives
# in this cgroup during a build is the gate, the sidecar, pi, AND the agent's
# own verification runs. Measured individually, in an identical 7G scope:
#
#   gate (svelte-check ‖ vitest, concurrent)   5.24 GB   ← the consumer
#   agent's own `npm run gate:test`            1.50 GB
#   sidecar 0.26 GB + pi 0.13 GB
#
# 5.24 of 7 leaves ~1.7 GB, so anything overlapping the gate tips it over —
# hence memory.peak pinned to the ceiling with 925 hits, and a vitest worker
# returning `Error: No such built-in module: node:`, a specifier truncated
# mid-string, which is what a worker dying under reclaim looks like from
# outside. It reads as a real defect in a file the change never touched, and it
# cost change requests #228 and #231 their runs.
#
# The tempting fix was to cap the worker pool, on the theory that vitest sizes
# it from the machine (8 cores → 7 workers) and NODE_OPTIONS' 4 GB heap is
# inherited by each. That arithmetic is wrong: `--max-old-space-size` is a
# CEILING, not a reservation, and the whole suite peaks at 1.5 GB. Capping the
# agent's runs was measured at −0.37 GB for +57% wall clock — a net loss. Every
# clean-room test of the cap passed because an isolated scope was never the
# failing condition; the shared cgroup was.
#
# So: give it headroom. 10G of 15.6, against ~4.4 GB resident for everything
# else, leaves the gate its 5.24 GB with room to overlap. Still a ceiling, not
# a reservation — a runaway agent is still bounded, just not by less than one
# gate run.
MemoryMax=10G
CPUQuota=600%

[Install]
WantedBy=multi-user.target
