[Unit]
Description=jkai WhatsApp worker — owns the WhatsApp session on the VPS. Separate from the web app so a deploy does not drop the socket, and from the builder so it never runs a second scheduler.
After=network.target

[Service]
Type=simple
User=johnk
WorkingDirectory=/opt/strange-rambling-svelte
EnvironmentFile=/opt/strange-rambling-svelte/.env
# The role is what makes this safe: it runs the WhatsApp socket and NOT the
# scheduler, and it is never treated as "delegated" — otherwise it would read
# WHATSAPP_BRIDGE_URL from this same file and forward sends to itself.
Environment=JKAI_SERVICE_ROLE=whatsapp
ExecStart=/usr/bin/node /opt/strange-rambling-svelte/packages/jkai-wa-worker/dist/start.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
