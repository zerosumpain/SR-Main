# Database
DATABASE_URL=postgresql://app:<password>@localhost:5433/strange_rambling

# Auth (Google OAuth)
AUTH_SECRET=<random-secret>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_EMAILS=your@email.com

# Agent API key
AGENT_API_KEY=<random-secret>

# All other API keys (Z.AI, Tavily) are stored in keys.json via the admin panel
# and must never be hardcoded or committed

# AES-256-GCM key for encrypting integration_credentials payloads.
# 32 bytes as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: losing this key makes every integration_credentials row unrecoverable.
# Must be the same value on dev and prod or encrypted rows can't be read across machines.
INTEGRATION_CREDENTIALS_KEY=

# Personal activity sources. These are application credentials; users authorize
# their own accounts through /jkai/sources and never paste passwords into JKAI.
STEAM_WEB_API_KEY=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Paste the .p8 content with literal \n separators, inside double quotes.
APPLE_MUSIC_PRIVATE_KEY=

# Playwright-based webframe sidecar used by the canvas webpage node
WEBFRAME_SERVICE_URL=http://webframe:3000

# Enables the gesture-based palette triggers (keyboard / right-click / long-press / drag-from-handle).
# Set to `false` to hide the gestures and fall back to a visible + button.
PUBLIC_CANVAS_NEW_PALETTE=true

# 32-byte hex shared secret for host-to-host calls. Two users:
# (a) the static bearer /api/mcp verifies on tools/call, and
# (b) the cross-host reads behind /admin/access/security, which shows homeserv
#     and the VPS side by side — so it MUST be identical on both hosts.
# Was HERMES_BRIDGE_SECRET; the old name is no longer read.
SERVICE_BRIDGE_SECRET=

# Base URL of the process that OWNS the WhatsApp session — packages/jkai-wa-worker
# (port 3110 on the VPS). Unset means this process runs its own Baileys socket.
# Was WHATSAPP_HERMES_BRIDGE_URL; the old name is no longer read.
WHATSAPP_BRIDGE_URL=

# Azure Blob Storage backend for the /drive file store.
# When AZURE_STORAGE_CONNECTION_STRING is set, shared file storage
# stores bytes in Azure Blob instead of local disk under WORKFLOW_FILES_ROOT.
# Leave BLANK in local/homeserv dev to keep the filesystem backend.
# Get the string: az storage account show-connection-string -g sr-drive-rg -n <acct>
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=drive
# jkai media store (attachments, intel, generated media) — same account, own container.
AZURE_MEDIA_CONTAINER=media
# Blog post images — same account, own container.
AZURE_BLOG_CONTAINER=blog

# Independent public-journey monitor used to backfill outages while the app is
# unavailable. Defaults to Porkserv's tailnet Gatus endpoint when unset.
DEPENDENCY_GATUS_URL=http://100.83.68.108:8082

# Wildmind's public snapshot (GET-only listener, tailnet address), read by the
# landing page's Wildmind chapter. Set it only where the site runs (the VPS's
# runtime env, a local preview's compose file). Leave BLANK and the chapter is
# not drawn and nothing is requested.
WILDMIND_SNAPSHOT_URL=

# App Store review demo switch for the iPhone app (POST /api/native/review-demo).
# The code Apple's reviewer types into "I have a pairing code"; the right one
# answers { demo: true } and the app runs on its own synthetic fixtures. Mints
# no credential. Leave BLANK to switch the route off (it 404s). Production only.
APP_REVIEW_DEMO_CODE=

# Model-plumbing lane for the extracted applications
# (GET /api/platform/models/config, POST /api/platform/models/usage).
# One credential per application, at least 32 characters, never shared between
# two applications: the credential is how a usage row is attributed. The same
# value goes into that application's MODEL_SERVICE_TOKEN. Blank = no lane.
MODEL_SERVICE_TOKEN_DRIVE=
MODEL_SERVICE_TOKEN_HEALTH=
MODEL_SERVICE_TOKEN_POLICY_ENGINE=
MODEL_SERVICE_TOKEN_DFE_DATA_STRATEGY=
MODEL_SERVICE_TOKEN_DATA_STANDARD_DESIGNER=
