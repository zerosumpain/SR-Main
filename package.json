    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "playwright": "^1.61.1",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.7",
    "shiki": "^4.0.2",
    "three": "^0.183.2",
    "tsdav": "^2.2.2",
    "undici": "^7.29.0",
    "vega": "^6.4.0",
