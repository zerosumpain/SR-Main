    "ical.js": "^2.2.1",
    "idb": "^8.0.3",
    "jsdom": "^29.0.1",
    "jszip": "^3.10.1",
    "layerchart": "^1.0.13",
    "mammoth": "^1.12.0",
    "marked": "^17.0.6",
    "mermaid": "^11.17.2",
