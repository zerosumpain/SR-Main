		"@types/sanitize-html": "^2.16.1",
		"@types/three": "^0.183.1",
		"@types/web-push": "^3.6.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"drizzle-kit": "^0.31.10",
		"fake-indexeddb": "^6.2.5",
		"svelte": "^5.51.0",
