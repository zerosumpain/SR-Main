{
  "name": "strange-rambling-svelte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "jkai": {
    "//piVersion": "The pi coding-agent version the autonomous builder runs. THE canonical pin: the sandbox Dockerfile, the host install in scripts/deploy-builder.sh, and PI_VERSION in src/lib/jkai/pi-runner.ts all derive from this, and a unit test fails if the runner's copy drifts. Upgrading pi means changing this value in a PR and letting a canary build prove it — not running `npm i -g` on the box. Read pi-runner.ts's assertPiVersion() for why an unpinned floating install is dangerous here.",
    "piVersion": "0.84.4",
    "//piPackage": "The npm package the pin is a version OF. Recorded because a version alone cannot detect the package MOVING: pi was renamed from @mariozechner/pi-coding-agent to @earendil-works/pi-coding-agent, and the abandoned name's dist-tag froze at the version we were pinned to. `npm view <old-name> version` answered 0.73.1 — our exact pin — for sixteen weeks while upstream shipped eleven minors under the new name. Every freshness check that could have been written against the old name would have reported us current. scripts/check-pi-version.mjs exists to catch that shape specifically.",
    "piPackage": "@earendil-works/pi-coding-agent",
    "//piUpstreamRepo": "The GitHub repo behind piPackage, checked ALONGSIDE npm rather than instead of it. The GitHub API answers a moved repo with a 301 to its new canonical name, so this is the identifier that survives a rename — it is how the 0.73.1 freeze was found at all. Update it only when upstream genuinely moves, and expect check-pi-version.mjs to tell you before you notice by hand.",
    "piUpstreamRepo": "earendil-works/pi"
  },
  "overrides": {
    "@asamuzakjp/css-color": "^5.1.11",
    "@xmldom/xmldom": "0.8.15",
    "minimatch@<10": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@>=10": {
      "brace-expansion": "5.0.9"
    },
    "docx": {
      "nanoid": "5.1.16"
    },
    "electron-to-chromium": "1.5.420",
    "fast-xml-parser": "5.11.1",
    "lodash-es": "4.18.1",
    "nanoid": "3.3.18",
    "picomatch": "4.0.7",
    "postcss": "8.5.28",
    "postcss-selector-parser": "6.1.4",
    "qs": "6.16.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "ws": "8.21.3"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:builder": "node packages/jkai-builder/build.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "NODE_OPTIONS=--max-old-space-size=8192 svelte-kit sync && NODE_OPTIONS=--max-old-space-size=8192 svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gate": "./scripts/gate-structural.sh && npm run gate:check && npm run gate:test && npm run gate:build",
    "gate:public-routes": "node scripts/check-public-routes.mjs",
    "gate:font-sizes": "node scripts/check-font-sizes.mjs",
    "gate:measure": "node scripts/check-measure.mjs",
    "gate:source-footprint": "node scripts/check-source-footprint.mjs",
    "gate:boundaries": "node scripts/check-module-boundaries.mjs",
    "gate:schema-imports": "node scripts/check-schema-imports.mjs",
    "gate:schema-drift": "node scripts/check-schema-drift.mjs",
    "gate:check": "npm run gate:sync && npm run gate:check:only",
    "gate:sync": "svelte-kit sync",
    "gate:check:only": "NODE_OPTIONS=--max-old-space-size=8192 svelte-check --tsconfig ./tsconfig.json --threshold error",
    "gate:concurrent": "./scripts/gate-concurrent.sh",
    "gate:test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --exclude '**/node_modules/**' --exclude '**/*.integration.test.ts'",
    "gate:test:full": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --exclude '**/node_modules/**'",
    "gate:build": "NODE_OPTIONS=--max-old-space-size=6144 vite build && npm run gate:client-budgets",
    "gate:client-budgets": "node scripts/check-client-budgets.mjs",
    "build:codex-bridge": "node packages/jkai-codex-bridge/build.mjs",
    "build:release-sidecars": "./scripts/build-release-sidecars.sh",
    "gate:test:scoped": "./scripts/gate-test-scoped.sh",
    "validate:change": "./scripts/validate-change.sh",
    "deploy:status": "./scripts/deploy-status.sh",
    "build:wa-worker": "node packages/jkai-wa-worker/build.mjs"
  },
  "devDependencies": {
